# Cloudflare Worker variables and secrets (set on the Worker, never committed)

# Brevo transactional email
BREVO_API_KEY=
REDEEM_TO_EMAIL=info@blockedge.earth
REDEEM_FROM_EMAIL=noreply@blockedge.earth

# Cloudflare Turnstile (optional but recommended)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Read by Astro at build time; set this in the Worker build variables
PUBLIC_TURNSTILE_SITE_KEY=

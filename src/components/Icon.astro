---
import {
  Leaf,
  Coins,
  Layers,
  LineChart,
  Activity,
  Map,
  FileBarChart,
  SearchCheck,
  Scale,
  ShieldCheck,
  BadgeCheck,
  TriangleAlert,
  ArrowLeftRight,
  Recycle,
  Wallet,
  Building2,
  Megaphone,
  CircleHelp,
  Mail,
  FileText,
  Briefcase,
  BookOpen,
  ArrowRight,
  ArrowUpRight,
  Check,
  Copy,
  ExternalLink,
  Lock,
  Globe2,
  Clock,
  Download,
  Info,
  Sparkles,
  Database,
  FileCheck2,
  Landmark,
  Fingerprint,
  Network,
  Gauge,
  Users,
  Zap,
} from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.7, class: className } = Astro.props;

const icons: Record<string, any> = {
  Leaf,
  Coins,
  Layers,
  LineChart,
  Activity,
  Map,
  FileBarChart,
  SearchCheck,
  Scale,
  ShieldCheck,
  BadgeCheck,
  TriangleAlert,
  ArrowLeftRight,
  Recycle,
  Wallet,
  Building2,
  Megaphone,
  CircleHelp,
  Mail,
  FileText,
  Briefcase,
  BookOpen,
  ArrowRight,
  ArrowUpRight,
  Check,
  Copy,
  ExternalLink,
  Lock,
  Globe2,
  Clock,
  Download,
  Info,
  Sparkles,
  Database,
  FileCheck2,
  Landmark,
  Fingerprint,
  Network,
  Gauge,
  Users,
  Zap,
};

const Cmp = icons[name] ?? CircleHelp;
---

<Cmp size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />

---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ChevronDown, Search, Menu, X, ArrowRight } from '@lucide/astro';
import Logo from '@components/Logo.astro';
import Icon from '@components/Icon.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import WalletButton from '@components/WalletButton.astro';
import { NAVIGATION } from '@data/site';
import { t, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const home = getRelativeLocaleUrl(locale);
const clean = Astro.url.pathname.replace(/^\/(en|th)(?=\/|$)/, '') || '/';

const groups = NAVIGATION.map((group) => ({
  ...group,
  active:
    group.items.some((item) => clean === item.path || clean.startsWith(item.path + '/')) ||
    Boolean(group.featured && clean === group.featured.path),
  hrefItems: group.items.map((item) => ({
    ...item,
    href: getRelativeLocaleUrl(locale, item.path.replace(/^\//, '')),
    active: clean === item.path || clean.startsWith(item.path + '/'),
  })),
  featuredHref: group.featured
    ? getRelativeLocaleUrl(locale, group.featured.path.replace(/^\//, ''))
    : null,
}));

---
<header class="site-header" data-header>
  <div class="container-wide site-header-inner">
    <Logo href={home} />

    <nav class="nav-desktop" aria-label={locale === 'th' ? 'เมนูหลัก' : 'Primary'}>
      {groups.map((group) => (
        <div class="nav-group">
          <button
            type="button"
            class:list={['nav-trigger', group.active && 'is-active']}
            data-nav-trigger
            aria-expanded="false"
            aria-controls={`nav-${group.id}`}
          >
            {group.label[locale]}
            <ChevronDown size={13} stroke-width={2} aria-hidden="true" />
          </button>
          <div class="nav-panel" id={`nav-${group.id}`} data-nav-panel data-open="false">
            <div class="nav-panel-grid">
              {group.hrefItems.map((item) => (
                <a href={item.href} class="nav-item" aria-current={item.active ? 'page' : undefined}>
                  <span class="nav-item-icon"><Icon name={item.icon} size={17} /></span>
                  <span>
                    <span class="nav-item-title">{item.label[locale]}</span>
                    <span class="nav-item-desc">{item.desc[locale]}</span>
                  </span>
                </a>
              ))}
            </div>
            {group.featured && group.featuredHref && (
              <a href={group.featuredHref} class="nav-featured">
                <span class="nav-featured-label">
                  <Icon name="Sparkles" size={13} />
                  {t('nav.featured', locale)}
                </span>
                <span class="nav-featured-title">{group.featured.label[locale]}</span>
                <span class="nav-featured-desc">{group.featured.desc[locale]}</span>
                <span class="nav-featured-arrow"><ArrowRight size={14} stroke-width={2} aria-hidden="true" /></span>
              </a>
            )}
          </div>
        </div>
      ))}
    </nav>

    <div class="nav-utility">
      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-label={t('search.open', locale)}
        aria-keyshortcuts="/ Control+K"
        title={locale === 'th' ? 'กด / เพื่อค้นหา' : 'Press / to search'}
      >
        <Search size={15} stroke-width={1.9} aria-hidden="true" />
        <span class="search-trigger-text">{t('common.search', locale)}</span>
        <kbd class="search-trigger-kbd">/</kbd>
      </button>
      <ThemeToggle locale={locale} />
      <LanguageSwitcher locale={locale} />
      <div class="wallet-slot wallet-desktop">
        <WalletButton locale={locale} />
      </div>
      <button
        type="button"
        class="icon-btn menu-btn"
        data-mobile-toggle
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label={t('common.openMenu', locale)}
      >
        <Menu size={20} stroke-width={1.8} class="menu-icon-open" aria-hidden="true" />
        <X size={20} stroke-width={1.8} class="menu-icon-close" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" data-mobile-drawer data-open="false">
    <button type="button" class="mobile-search" data-search-open>
      <Search size={16} stroke-width={1.9} aria-hidden="true" />
      {t('search.title', locale)}
    </button>

    {groups.map((group) => (
      <details class="mobile-group">
        <summary>
          {group.label[locale]}
          <ChevronDown size={16} stroke-width={1.8} aria-hidden="true" />
        </summary>
        <div class="mobile-group-links">
          {group.hrefItems.map((item) => (
            <a href={item.href} class="mobile-link" aria-current={item.active ? 'page' : undefined}>
              <span class="mobile-link-label">
                <Icon name={item.icon} size={16} />
                {item.label[locale]}
              </span>
              <ArrowRight size={14} stroke-width={1.8} aria-hidden="true" />
            </a>
          ))}
          {group.featured && group.featuredHref && (
            <a href={group.featuredHref} class="mobile-link mobile-link-featured">
              <span class="mobile-link-label">
                <Icon name="Sparkles" size={16} />
                {group.featured.label[locale]}
              </span>
              <ArrowRight size={14} stroke-width={1.8} aria-hidden="true" />
            </a>
          )}
        </div>
      </details>
    ))}

    <div class="mobile-utility">
      <div class="mobile-utility-row">
        <span class="mobile-utility-label">{t('nav.theme', locale)}</span>
        <div class="mobile-utility-controls">
          <ThemeToggle locale={locale} />
          <LanguageSwitcher locale={locale} />
        </div>
      </div>
      <div class="mobile-wallet">
        <WalletButton locale={locale} full />
      </div>
    </div>
  </div>

<style>
  .site-header-inner { position: relative; }
  .nav-group { position: static; }
  .nav-featured {
    display: block;
    margin-top: 4px;
    padding: 14px 14px 15px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: linear-gradient(100deg, var(--brand-soft), transparent 65%);
    transition: border-color 0.2s ease;
  }
  .nav-featured:hover { border-color: var(--brand); }
  .nav-featured-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .nav-featured-title {
    display: block;
    margin-top: 5px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .nav-featured-desc {
    display: block;
    margin-top: 2px;
    font-size: 1rem;
    color: var(--ink-3);
    max-width: 56ch;
  }
  .nav-featured-arrow {
    position: absolute;
    right: 14px;
    bottom: 16px;
    color: var(--brand);
  }
  .nav-featured { position: relative; }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 8px 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-3);
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .search-trigger:hover { border-color: var(--line-strong); color: var(--ink); }
  .search-trigger-text { display: none; }
  @media (min-width: 1320px) { .search-trigger-text { display: inline; } }
  .search-trigger-kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 1px 4px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--surface-2);
    color: var(--ink-3);
  }
  @media (min-width: 1460px) { .search-trigger-kbd { display: inline; } }

  .menu-btn { display: grid; }
  @media (min-width: 1200px) { .menu-btn { display: none; } }
  .wallet-slot { display: none; }
  @media (min-width: 1200px) { .wallet-slot { display: block; } }
  .menu-icon-close { display: none; }
  .menu-btn[aria-expanded='true'] .menu-icon-open { display: none; }
  .menu-btn[aria-expanded='true'] .menu-icon-close { display: block; }

  .mobile-drawer { display: block; }
  .mobile-search {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    min-height: 44px;
    margin-bottom: 8px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-3);
    font-size: 1rem;
    cursor: pointer;
  }
  .mobile-group-links { padding-bottom: 8px; }
  .mobile-link-featured { color: var(--brand); }
  .mobile-link-featured .mobile-link-label { font-weight: 550; }
  .mobile-link-label { display: inline-flex; align-items: center; gap: 10px; }
  .mobile-utility {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .mobile-utility-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .mobile-utility-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .mobile-utility-controls { display: flex; align-items: center; gap: 4px; }
  .mobile-wallet { padding-bottom: 8px; }

  @media (min-width: 1080px) {
    .mobile-drawer { display: none; }
  }
</style>

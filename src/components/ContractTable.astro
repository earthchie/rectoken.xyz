---
import { Copy, ArrowUpRight } from '@lucide/astro';
import { CONTRACTS, CHAINS } from '@data/site';
import type { Locale } from '@i18n/utils';
import { shortAddress } from '@utils/format';

interface Props {
  lang: Locale;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;

const rows = [
  {
    label: { en: 'Pool token', th: 'พูลโทเคน' },
    chain: 'ThaiFi',
    address: CONTRACTS.poolThaiFi,
    explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.poolThaiFi}`,
    note: { en: 'Active primary deployment', th: 'สัญญาหลักที่ใช้งานอยู่' },
  },
  {
    label: { en: 'Retired token', th: 'โทเคนไถ่ถอน' },
    chain: 'ThaiFi',
    address: CONTRACTS.retiredToken,
    explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.retiredToken}`,
    note: { en: 'Total retirements', th: 'ยอดไถ่ถอนรวม' },
  },
  ...(compact
    ? []
    : [
        {
          label: { en: 'Retirement certificate NFT', th: 'NFT ใบรับรองการไถ่ถอน' },
          chain: 'ThaiFi',
          address: CONTRACTS.certificateNft,
          explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.certificateNft}`,
          note: { en: 'Certificate records', th: 'บันทึกใบรับรอง' },
        },
      ]),
  {
    label: { en: 'Pool token', th: 'พูลโทเคน' },
    chain: 'Optimism',
    address: CONTRACTS.poolOptimism,
    explorer: `${CHAINS.optimism.explorer}/token/${CONTRACTS.poolOptimism}`,
    note: { en: 'Bridged deployment', th: 'สัญญาที่เชื่อมข้ามเชน' },
  },
  {
    label: { en: 'Pool token', th: 'พูลโทเคน' },
    chain: 'Kubchain',
    address: CONTRACTS.poolKubchain,
    explorer: `${CHAINS.kubchain.explorer}/address/${CONTRACTS.poolKubchain}`,
    note: { en: 'Bridged deployment', th: 'สัญญาที่เชื่อมข้ามเชน' },
  },
  ...(compact
    ? []
    : [
        {
          label: { en: 'Bridge lock', th: 'สัญญาล็อก' },
          chain: 'ThaiFi',
          address: CONTRACTS.bridgeOptimism,
          explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.bridgeOptimism}`,
          note: { en: 'Optimism bridge, not a token', th: 'สะพาน Optimism ไม่ใช่โทเคน' },
        },
        {
          label: { en: 'Bridge lock', th: 'สัญญาล็อก' },
          chain: 'ThaiFi',
          address: CONTRACTS.bridgeKubchain,
          explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.bridgeKubchain}`,
          note: { en: 'Kubchain bridge, not a token', th: 'สะพาน Kubchain ไม่ใช่โทเคน' },
        },
        {
          label: { en: 'Whitepaper reference', th: 'ที่อยู่ในไวท์เปเปอร์' },
          chain: 'ThaiFi',
          address: CONTRACTS.whitepaperThaiFiRef,
          explorer: `${CHAINS.thaifi.explorer}/address/${CONTRACTS.whitepaperThaiFiRef}`,
          note: { en: 'Recorded in Whitepaper v1.0 §1.1', th: 'บันทึกในไวท์เปเปอร์ v1.0 §1.1' },
        },
      ]),
];
---

<div class="contract-list">
  {rows.map((row) => (
    <div class="contract-row">
      <span class="contract-label">
        {row.label[lang]}
        <small>{row.note[lang]}</small>
      </span>
      <a class="address" href={row.explorer} target="_blank" rel="noopener noreferrer">
        <span class="hide-sm">{row.address}</span>
        <span class="show-sm">{shortAddress(row.address)}</span>
      </a>
      <div class="contract-actions">
        <span class="chip">{row.chain}</span>
        <button type="button" class="copy-btn" data-copy={row.address} aria-label={lang === 'th' ? `คัดลอกที่อยู่ ${row.address}` : `Copy ${row.address}`} title={lang === 'th' ? 'คัดลอก' : 'Copy'}>
          <Copy size={14} />
        </button>
        <a class="copy-btn" href={row.explorer} target="_blank" rel="noopener noreferrer" aria-label={lang === 'th' ? `เปิดเครื่องมือสำรวจบล็อกเชนสำหรับ ${row.label.th} บน ${row.chain} ที่อยู่ ${row.address}` : 'Open explorer'} title={lang === 'th' ? 'เปิดเครื่องมือสำรวจบล็อกเชน' : 'Open explorer'}>
          <ArrowUpRight size={14} />
        </a>
      </div>
    </div>
  ))}
</div>

<style>
  .contract-label { display: flex; flex-direction: column; gap: 3px; }
  .contract-label small {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-3);
    opacity: 0.9;
  }
  .contract-actions { display: flex; align-items: center; gap: 4px; }
  .address { display: inline-flex; align-items: center; gap: 6px; }
  .address:hover { color: var(--brand); }
  .show-sm { display: none; }
  @media (max-width: 720px) {
    .hide-sm { display: none; }
    .show-sm { display: inline; }
  }
</style>

---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowRight, ShieldAlert, Scale, Mail } from '@lucide/astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Icon from '@components/Icon.astro';
import { FAQ_CATEGORIES, FAQ_COMPARISON, INDIVIDUAL_NOTICE } from '@data/faq';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const l = (path: string) => getRelativeLocaleUrl(lang, path);
const pick = (value: { en: string; th: string }) => value[lang] ?? value.en;
---

<BaseLayout
  title={lang === 'th' ? 'คำถามที่พบบ่อย' : 'FAQ'}
  description={lang === 'th' ? 'การแลกคืน การไถ่ถอน ค่าธรรมเนียม ระยะเวลา และสิทธิ์ตามกรอบรายงาน' : 'Redemption, retirement, fees, timelines and framework eligibility.'}
  locale={lang}
>
  <PageHero
    eyebrow={lang === 'th' ? 'คำถามที่พบบ่อย' : 'FAQ'}
    title={lang === 'th' ? 'การแลกคืนกับการไถ่ถอน' : 'Redemption vs retirement'}
    description={lang === 'th' ? 'ความแตกต่างระหว่างการแลกคืนสำหรับองค์กรและการไถ่ถอนสำหรับบุคคลธรรมดา เลือกตามประเภทผู้ใช้และสิ่งที่ต้องการกล่าวอ้าง' : 'The difference between corporate redemption and individual retirement. Choose based on your user type and the claim you need to make.'}
    locale={lang}
    chips={[`${FAQ_CATEGORIES.reduce((sum, category) => sum + category.items.length, 0)} ${lang === 'th' ? 'คำถาม' : 'questions'}`, lang === 'th' ? '7 หมวด' : '7 categories', 'I-REC', 'Scope 2']}
    actions={[
      { label: lang === 'th' ? 'เริ่มแลกคืน' : 'Start a redemption', href: l('redeem'), variant: 'primary' },
      { label: lang === 'th' ? 'ติดต่อ' : 'Contact', href: l('contact') },
    ] as any}
  />

  <section class="section-tight">
    <div class="container-page">
      <div class="faq-index">
        {FAQ_CATEGORIES.map((category) => (
          <a href={`#faq-${category.id}`} class="faq-index-link">
            <Icon name={category.icon} size={15} />
            {pick(category.title)}
          </a>
        ))}
      </div>

      <div class="comparison-card">
        <div class="comparison-head">
          <div>
            <p class="eyebrow">{lang === 'th' ? 'เปรียบเทียบ' : 'Comparison'}</p>
            <h2 class="h3" style="margin-top:8px">{pick(FAQ_COMPARISON.title)}</h2>
          </div>
          <span class="chip"><Scale size={11} /> {lang === 'th' ? 'ตามประเภทผู้ใช้' : 'By user type'}</span>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>{FAQ_COMPARISON.columns.map((col) => <th>{pick(col)}</th>)}</tr>
            </thead>
            <tbody>
              {FAQ_COMPARISON.rows.map((row, rowIndex) => (
                <tr>
                  {row.map((cell, cellIndex) => (
                    <td class:list={[cellIndex === 0 && 'row-label', cellIndex === 1 && 'col-corporate', cellIndex === 2 && 'col-individual']}>
                      {pick(cell)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="faq-categories">
        {FAQ_CATEGORIES.map((category) => (
          <section class="faq-category" id={`faq-${category.id}`}>
            <div class="faq-category-head">
              <div class="faq-category-icon"><Icon name={category.icon} size={18} /></div>
              <div>
                <h2 class="h3">{pick(category.title)}</h2>
                <p>{category.items.length} {lang === 'th' ? 'คำถาม' : 'questions'}</p>
              </div>
            </div>
            <div class="accordion" data-accordion="single">
              {category.items.map((item, i) => (
                <div class="acc-item">
                  <button
                    type="button"
                    class="acc-trigger"
                    aria-expanded="false"
                    aria-controls={`faq-${category.id}-${i}`}
                    data-acc-trigger
                  >
                    {pick(item.q)}
                    <span aria-hidden="true" style="font-size:1.1rem;line-height:1">+</span>
                  </button>
                  <div class="acc-panel" id={`faq-${category.id}-${i}`} data-open="false">
                    <div class="acc-panel-inner">
                      <div class="acc-panel-content">{pick(item.a)}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="individual-notice">
        <div class="individual-notice-head">
          <ShieldAlert size={20} />
          <div>
            <p class="eyebrow">{lang === 'th' ? 'สำหรับบุคคลธรรมดา' : 'For individual users'}</p>
            <h2 class="h3" style="margin-top:6px">{pick(INDIVIDUAL_NOTICE.title)}</h2>
          </div>
        </div>
        {INDIVIDUAL_NOTICE.body.map((paragraph) => (
          <p>{pick(paragraph)}</p>
        ))}
      </div>

      <div class="faq-contact">
        <div>
          <p class="eyebrow">{lang === 'th' ? 'ยังมีคำถาม' : 'Still unsure'}</p>
          <h2 class="h3" style="margin-top:8px">{lang === 'th' ? 'ถามทีมงานโดยตรง' : 'Ask the team directly.'}</h2>
          <p>{lang === 'th' ? 'สำหรับคำถามเรื่องสิทธิ์ตามกรอบรายงาน โปรดปรึกษาเจ้าของกรอบหรือผู้ให้ความเชื่อมั่นด้วย' : 'For framework eligibility, also consult the framework owner or your assurance provider.'}</p>
        </div>
        <div class="faq-contact-actions">
          <a class="btn btn-primary" href={l('contact')}>
            <Mail size={15} stroke-width={1.9} />
            {lang === 'th' ? 'ติดต่อ' : 'Contact'}
          </a>
          <a class="btn btn-secondary" href={l('compliance/claims')}>
            {lang === 'th' ? 'ตารางสิทธิ์' : 'Eligibility table'}
            <ArrowRight size={14} stroke-width={2} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-index { display: flex; flex-wrap: wrap; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .faq-index-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 1rem;
    color: var(--ink-2);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .faq-index-link:hover { border-color: var(--brand); color: var(--brand); }

  .comparison-card { margin-top: 22px; padding: 22px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .comparison-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .row-label { font-family: var(--font-mono); font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); white-space: nowrap; }
  .col-corporate { color: var(--brand); font-weight: 550; }
  .col-individual { color: var(--info); font-weight: 550; }

  .faq-categories { display: grid; gap: 28px; margin-top: 32px; }
  .faq-category { scroll-margin-top: 96px; }
  .faq-category-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 3px; }
  .faq-category-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--brand-soft); color: var(--brand); flex-shrink: 0; }
  .faq-category-head h2 { font-size: 1.15rem; }
  .faq-category-head p { margin-top: 3px; font-family: var(--font-mono); font-size: 14px; color: var(--ink-3); letter-spacing: 0.05em; }

  .individual-notice { margin-top: 34px; padding: 24px; border: 1px solid color-mix(in srgb, var(--warning) 30%, transparent); border-left: 3px solid var(--warning); border-radius: var(--radius-md); background: var(--warning-bg); }
  .individual-notice-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; }
  .individual-notice-head svg { color: var(--warning); flex-shrink: 0; margin-top: 2px; }
  .individual-notice > p { margin-top: 9px; font-size: 1rem; line-height: 1.65; color: var(--ink-2); max-width: 82ch; }

  .faq-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .faq-contact p { margin-top: 5px; font-size: 1rem; color: var(--ink-3); max-width: 62ch; }
  .faq-contact-actions { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

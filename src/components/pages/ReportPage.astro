---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  ArrowLeft,
  ArrowRight,
  CheckCircle2,
  Download,
  ExternalLink,
  FileCheck2,
  Info,
  Printer,
  ShieldCheck,
} from '@lucide/astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { ReportData } from '@data/report-may-2026';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
  report: ReportData;
}
const { lang, report } = Astro.props;
const r = report;
const t = (value: { en: string; th: string }) => value[lang];
const label = (value: string | { en: string; th: string }) =>
  typeof value === 'string' ? value : t(value);
const l = (path: string) => getRelativeLocaleUrl(lang, path);

const contents = [
  { id: 'summary', no: '01', label: { en: 'Executive summary', th: 'บทสรุปผู้บริหาร' } },
  { id: 'scope', no: '02', label: { en: 'Scope of review', th: 'ขอบเขตการตรวจสอบ' } },
  { id: 'reserve', no: '03', label: { en: 'Reserve asset summary', th: 'สรุปสินทรัพย์สำรอง' } },
  { id: 'supply', no: '04', label: { en: 'Token supply summary', th: 'สรุปจำนวนโทเคน' } },
  { id: 'reconciliation', no: '05', label: { en: 'Reserve reconciliation', th: 'การกระทบยอดสินทรัพย์สำรอง' } },
  { id: 'coverage', no: '06', label: { en: 'Reserve coverage ratio', th: 'อัตราความครอบคลุมของสินทรัพย์สำรอง' } },
  { id: 'retirement', no: '07', label: { en: 'Retirement treatment', th: 'การพิจารณารายการไถ่ถอน' } },
  { id: 'representation', no: '08', label: { en: 'Reserve representation', th: 'คำรับรองเกี่ยวกับสินทรัพย์สำรอง' } },
  { id: 'findings', no: '09', label: { en: 'Findings', th: 'ข้อค้นพบ' } },
  { id: 'conclusion', no: '10', label: { en: 'Conclusion', th: 'ข้อสรุป' } },
];

const pageTitle =
  lang === 'th'
    ? `รายงานพอร์ต REC - ${t(r.period)}`
    : `REC Portfolio Report - ${t(r.period)}`;
---

<BaseLayout
  title={pageTitle}
  description={t(r.lede)}
  locale={lang}
  bodyClass="report-body"
>
  <div class="report-toolbar no-print">
    <div class="container-page report-toolbar-inner">
      <a class="report-back" href={l('reports')}>
        <ArrowLeft size={15} stroke-width={2} />
        {lang === 'th' ? 'รายงานรายเดือน' : 'Monthly reports'}
      </a>
      <div class="report-toolbar-actions">
        <button type="button" class="report-print-btn" data-print-report>
          <Printer size={16} stroke-width={1.9} />
          {lang === 'th' ? 'ดาวน์โหลด PDF' : 'Download PDF'}
        </button>
      </div>
    </div>
    <p class="report-print-hint">
      {lang === 'th'
        ? 'เลือก "บันทึกเป็น PDF" ในหน้าต่างพิมพ์เพื่อส่งออกเอกสาร'
        : 'Choose "Save as PDF" in the print dialog to export this report.'}
    </p>
  </div>

  <article class="report-paper">
    <header class="report-cover">
      <div class="report-cover-brand">
        <span class="report-brand-mark"><ShieldCheck size={18} stroke-width={2} /></span>
        <span>
          <strong>RECTOKEN</strong>
          <small>BY BLOCKEDGE</small>
        </span>
        <span class="report-cover-type">{lang === 'th' ? 'รายงานรายเดือน' : 'Monthly report'}</span>
      </div>

      <div class="report-cover-body">
        <div class="report-cover-copy">
          <p class="report-eyebrow">
            <span class="dot dot-live"></span>
            {t(r.kicker)}
          </p>
          <h1>
            {t(r.title)}
            <span>{t(r.period)}</span>
          </h1>
          <p class="report-lede">{t(r.lede)}</p>
          <p class="report-cutoff">{t(r.dataCutoff)}</p>
        </div>

        <aside class="report-verdict" aria-label={lang === 'th' ? 'ผลการทดสอบสำรอง' : 'Reserve test result'}>
          <span class="report-verdict-label">
            {lang === 'th' ? 'ผลการทดสอบสำรอง' : 'Reserve test result'}
          </span>
          <strong>{t(r.status)}</strong>
          <span class="report-verdict-ratio">
            {r.metrics[3].value}<span>%</span>
          </span>
          <span class="report-verdict-note">
            {lang === 'th' ? 'ความครอบคลุมของสินทรัพย์สำรอง' : 'Reserve coverage ratio'}
          </span>
        </aside>
      </div>

      <dl class="report-meta">
        {r.meta.map((item) => (
          <div>
            <dt>{t(item.label)}</dt>
            <dd>{t(item.value)}</dd>
          </div>
        ))}
      </dl>

      <section class="report-glance" aria-label={lang === 'th' ? 'ตัวเลขสำคัญ' : 'Key figures'}>
        {r.metrics.map((metric) => (
          <div class:list={['report-metric', `report-metric-${metric.tone}`]}>
            <span class="report-metric-label">{t(metric.label)}</span>
            <span class="report-metric-value">
              {metric.value}
              <small>{metric.unit}</small>
            </span>
          </div>
        ))}
      </section>
    </header>

    <nav class="report-contents no-print" aria-label={lang === 'th' ? 'สารบัญรายงาน' : 'Report contents'}>
      <p class="report-contents-title">{lang === 'th' ? 'ในรายงานนี้' : 'In this report'}</p>
      <div class="report-contents-grid">
        {contents.map((item) => (
          <a href={`#${item.id}`}>
            <span>{item.no}</span>
            {t(item.label)}
          </a>
        ))}
      </div>
    </nav>

    <section class="report-section" id="summary">
      <div class="report-section-head">
        <span class="report-index">01</span>
        <h2>{lang === 'th' ? 'บทสรุปผู้บริหาร' : 'Executive summary'}</h2>
      </div>
      <div class="report-prose">
        <p>{t(r.summary.paragraphs[0])}</p>
        <p>{t(r.summary.paragraphs[1])}</p>
      </div>

      {r.movementNote.en && (
        <div class="report-movement">
          <Info size={17} stroke-width={1.9} />
          <p>{t(r.movementNote)}</p>
        </div>
      )}

      <div class="report-table-wrap">
        <table class="report-table">
          <caption class="sr-only">
            {lang === 'th' ? 'สถานะสินทรัพย์สำรองและจำนวนโทเคน' : 'Reserve position and tokenized supply'}
          </caption>
          <thead>
            <tr>
              <th scope="col">{lang === 'th' ? 'รายการ' : 'Item'}</th>
              <th scope="col" class="num">{lang === 'th' ? 'จำนวน' : 'Amount'}</th>
              <th scope="col">{lang === 'th' ? 'หน่วย' : 'Unit'}</th>
            </tr>
          </thead>
          <tbody>
            {r.summary.rows.map((row) => (
              <tr class:list={{ 'is-emphasis': row.emphasis }}>
                <th scope="row">{t(row.label)}</th>
                <td class="num">{row.value}</td>
                <td>{row.unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="report-callout report-callout-pass">
        <CheckCircle2 size={18} stroke-width={2} />
        <p>{t(r.summary.conclusion)}</p>
      </div>
      <p class="report-small">{t(r.summary.websiteNote)}</p>
    </section>

    <section class="report-section" id="scope">
      <div class="report-section-head">
        <span class="report-index">02</span>
        <h2>{lang === 'th' ? 'ขอบเขตการตรวจสอบ' : 'Scope of review'}</h2>
      </div>
      <p class="report-prose">{t(r.scope.intro)}</p>
      <ol class="report-source-list">
        {r.scope.sources.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{t(source)}</p>
          </li>
        ))}
      </ol>
      <div class="report-callout report-callout-neutral">
        <FileCheck2 size={18} stroke-width={1.8} />
        <p>{t(r.scope.disclaimer)}</p>
      </div>
    </section>

    <section class="report-section" id="reserve">
      <div class="report-section-head">
        <span class="report-index">03</span>
        <h2>{lang === 'th' ? 'สรุปสินทรัพย์สำรอง' : 'Reserve asset summary'}</h2>
      </div>
      <p class="report-prose">{t(r.reserve.intro)}</p>

      <div class="report-table-wrap">
        <table class="report-table report-table-attributes">
          <caption class="sr-only">
            {lang === 'th' ? 'คุณลักษณะของสินทรัพย์สำรอง' : 'Reserve asset attributes'}
          </caption>
          <tbody>
            {r.reserve.attributes.map((row) => (
              <tr>
                <th scope="row">{t(row.label)}</th>
                <td>{t(row.value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="report-vintage">
        <h3 class="report-subhead">{t(r.reserve.vintageTitle)}</h3>
        <div class="report-bars">
          {r.reserve.vintages.map((vintage) => (
            <div class="report-bar-row">
              <span class="report-bar-label">{vintage.label}</span>
              <span class="report-bar-track">
                <span class="report-bar-fill" style={`--w:${vintage.percent}%`}></span>
              </span>
              <span class="report-bar-value">
                {vintage.value} <small>{vintage.unit}</small>
              </span>
              <span class="report-bar-percent">{vintage.percent.toFixed(2)}%</span>
            </div>
          ))}
        </div>
        <div class="report-total-row">
          <span>{t(r.reserve.total.label)}</span>
          <strong>
            {r.reserve.total.value} <small>{r.reserve.total.unit}</small>
          </strong>
        </div>
      </div>
    </section>

    <section class="report-section" id="supply">
      <div class="report-section-head">
        <span class="report-index">04</span>
        <h2>{lang === 'th' ? 'สรุปจำนวนโทเคน' : 'Token supply summary'}</h2>
      </div>
      <p class="report-prose">{t(r.supply.intro)}</p>

      <div class="report-table-wrap">
        <table class="report-table">
          <caption class="sr-only">
            {lang === 'th' ? 'จำนวนโทเคน REC และยอดคงเหลือ' : 'REC token supply and balances'}
          </caption>
          <thead>
            <tr>
              <th scope="col">{lang === 'th' ? 'รายการ' : 'Item'}</th>
              <th scope="col" class="num">{lang === 'th' ? 'จำนวน' : 'Amount'}</th>
              <th scope="col">{lang === 'th' ? 'หน่วย' : 'Unit'}</th>
            </tr>
          </thead>
          <tbody>
            {r.supply.rows.map((row) => (
              <tr class:list={{ 'is-emphasis': row.emphasis }}>
                <th scope="row">
                  {t(row.label)}
                  {row.note && <small class="report-row-note">{t(row.note)}</small>}
                </th>
                <td class="num">{row.value}</td>
                <td>{row.unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="report-subhead">{t(r.supply.compositionTitle)}</h3>
      <div class="report-composition" role="img" aria-label={t(r.supply.compositionTitle)}>
        <div class="report-composition-bar">
          {r.supply.composition.map((part) => (
            <span style={`--w:${part.percent}%`} class:list={['report-composition-fill', part.label.en === 'Kubchain' ? 'is-kubchain' : part.label.en === 'Optimism' ? 'is-optimism' : 'is-pool']}></span>
          ))}
        </div>
        <div class="report-composition-legend">
          {r.supply.composition.map((part) => (
            <div>
              <span class:list={['report-legend-dot', part.label.en === 'Kubchain' ? 'is-kubchain' : part.label.en === 'Optimism' ? 'is-optimism' : 'is-pool']}></span>
              <span>{t(part.label)}</span>
              <strong>{part.percent.toFixed(2)}%</strong>
            </div>
          ))}
        </div>
      </div>
      <p class="report-small">{t(r.supply.note)}</p>
      <p class="report-small report-small-strong">{t(r.supply.retiredNote)}</p>
    </section>

    <section class="report-section" id="reconciliation">
      <div class="report-section-head">
        <span class="report-index">05</span>
        <h2>{lang === 'th' ? 'การกระทบยอดสินทรัพย์สำรอง' : 'Reserve reconciliation'}</h2>
      </div>
      <div class="report-test">
        <span>{lang === 'th' ? 'เกณฑ์ทดสอบหลัก' : 'Core reserve test'}</span>
        <p>{t(r.reconciliation.test)}</p>
      </div>

      <div class="report-table-wrap">
        <table class="report-table">
          <caption class="sr-only">
            {lang === 'th' ? 'การกระทบยอดสินทรัพย์สำรอง' : 'Reserve reconciliation'}
          </caption>
          <thead>
            <tr>
              <th scope="col">{lang === 'th' ? 'รายการ' : 'Item'}</th>
              <th scope="col" class="num">{lang === 'th' ? 'จำนวน' : 'Amount'}</th>
              <th scope="col">{lang === 'th' ? 'หน่วย' : 'Unit'}</th>
            </tr>
          </thead>
          <tbody>
            {r.reconciliation.rows.map((row) => (
              <tr class:list={{ 'is-emphasis': row.emphasis }}>
                <th scope="row">{t(row.label)}</th>
                <td class="num">{row.value}</td>
                <td>{row.unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="report-pass-row">
        <span class="report-pass-pill">
          <CheckCircle2 size={16} stroke-width={2.2} />
          {lang === 'th' ? 'ผลลัพธ์' : 'Result'}: {t(r.reconciliation.result)}
        </span>
        <p>{t(r.reconciliation.conclusion)}</p>
      </div>
    </section>

    <section class="report-section" id="coverage">
      <div class="report-section-head">
        <span class="report-index">06</span>
        <h2>{lang === 'th' ? 'อัตราความครอบคลุมของสินทรัพย์สำรอง' : 'Reserve coverage ratio'}</h2>
      </div>

      <div class="report-coverage">
        <div class="report-coverage-number">
          {r.coverage.ratio}<span>%</span>
        </div>
        <div class="report-coverage-copy">
          <p class="report-formula-label">{t(r.coverage.formulaLabel)}</p>
          <div class="report-formula">
            <span>{r.coverage.numerator}</span>
            <span class="report-formula-line"></span>
            <span>{r.coverage.denominator}</span>
          </div>
          <p>{t(r.coverage.conclusion)}</p>
        </div>
      </div>
      <div class="report-coverage-track" aria-hidden="true">
        <span></span>
        <em>{r.coverage.ratio}%</em>
      </div>
    </section>

    <section class="report-section" id="retirement">
      <div class="report-section-head">
        <span class="report-index">07</span>
        <h2>{lang === 'th' ? 'การพิจารณารายการไถ่ถอน' : 'Retirement treatment'}</h2>
      </div>
      <div class="report-prose">
        {r.retirement.paragraphs.map((paragraph) => (
          <p>{t(paragraph)}</p>
        ))}
      </div>
      <div class="report-two-up">
        {r.retirement.cards.map((card) => (
          <div class="report-data-card">
            <span>{t(card.label)}</span>
            <strong>
              {card.value} <small>{card.unit}</small>
            </strong>
            <p>{t(card.note)}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="report-section" id="representation">
      <div class="report-section-head">
        <span class="report-index">08</span>
        <h2>{lang === 'th' ? 'คำรับรองเกี่ยวกับสินทรัพย์สำรอง' : 'Reserve representation'}</h2>
      </div>
      <p class="report-prose">{t(r.representations.intro)}</p>
      <ol class="report-numbered-list">
        {r.representations.items.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{t(item)}</p>
          </li>
        ))}
      </ol>
      <p class="report-small">{t(r.representations.note)}</p>
    </section>

    <section class="report-section" id="findings">
      <div class="report-section-head">
        <span class="report-index">09</span>
        <h2>{lang === 'th' ? 'ข้อค้นพบ' : 'Findings'}</h2>
      </div>
      <ol class="report-numbered-list report-findings">
        {r.findings.items.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{t(item)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="report-section report-conclusion" id="conclusion">
      <div class="report-section-head">
        <span class="report-index">10</span>
        <h2>{lang === 'th' ? 'ข้อสรุป' : 'Conclusion'}</h2>
      </div>
      <div class="report-prose">
        {r.conclusion.paragraphs.map((paragraph) => (
          <p>{t(paragraph)}</p>
        ))}
      </div>
    </section>

    <div class="report-end-actions no-print">
      <button type="button" class="report-print-btn" data-print-report>
        <Download size={16} stroke-width={1.9} />
        {lang === 'th' ? 'ดาวน์โหลดรายงานเป็น PDF' : 'Download this report as PDF'}
      </button>
    </div>

    <footer class="report-colophon">
      <p class="report-tagline">{t(r.conclusion.tagline)}</p>
      <div>
        <strong>RECTOKEN</strong>
        <span>{lang === 'th' ? 'รายงานพอร์ต REC' : 'REC Portfolio Report'} · {t(r.period)}</span>
      </div>
      <nav aria-label={lang === 'th' ? 'แหล่งข้อมูล' : 'Sources'}>
        {r.footer.sources.map((source) => (
          <a href={source.href === '/data' ? l('data') : source.href} target={source.href.startsWith('http') ? '_blank' : undefined} rel={source.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {label(source.label)}
            {source.href.startsWith('http') ? <ExternalLink size={11} stroke-width={2} /> : <ArrowRight size={11} stroke-width={2} />}
          </a>
        ))}
      </nav>
      <p>{t(r.footer.disclaimer)}</p>
    </footer>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-print-report]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .report-body {
    background:
      radial-gradient(900px circle at 90% 0%, var(--brand-soft), transparent 55%),
      var(--surface-2);
  }

  .report-toolbar {
    padding-block: 18px 0;
  }
  .report-toolbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1080px;
  }
  .report-back,
  .report-source-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 1rem;
    color: var(--ink-3);
    transition: color 0.2s ease;
  }
  .report-back:hover,
  .report-source-link:hover { color: var(--brand); }
  .report-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .report-print-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--brand);
    border-radius: var(--radius-sm);
    background: var(--brand);
    color: var(--ink-inverse);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .report-print-btn:hover {
    background: var(--brand-strong);
    transform: translateY(-1px);
  }
  .report-print-hint {
    max-width: 1080px;
    margin: 8px auto 0;
    font-size: 14px;
    color: var(--ink-3);
  }
  @media (max-width: 700px) {
    .report-toolbar-inner { align-items: flex-start; flex-direction: column; }
    .report-toolbar-actions { width: 100%; justify-content: space-between; }
  }

  .report-paper {
    width: min(1080px, calc(100% - 32px));
    margin: 22px auto 64px;
    padding: clamp(24px, 4.5vw, 64px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .report-cover {
    position: relative;
    padding-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
  }
  .report-cover::before {
    content: '';
    position: absolute;
    inset: calc(clamp(24px, 4.5vw, 64px) * -1) calc(clamp(24px, 4.5vw, 64px) * -1) auto;
    height: 6px;
    background: var(--gradient-headline);
  }
  .report-cover-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .report-brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--brand-soft);
    color: var(--brand);
  }
  .report-cover-brand > span:nth-child(2) {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .report-cover-brand strong {
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .report-cover-brand small {
    font-family: var(--font-mono);
    font-size: 14px;

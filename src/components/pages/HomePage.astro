---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  ShieldCheck,
  FileText,
  FileBarChart,
  Megaphone,
  Scale,
} from '@lucide/astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHead from '@components/SectionHead.astro';
import Icon from '@components/Icon.astro';
import { SITE, REGULATOR_PROFILES, CONTRACTS, CHAINS } from '@data/site';
import {
  HERO,
  ASSET_SECTION,
  REGULATOR_SECTION,
  LIFECYCLE,
  STANDARDS,
  WHY,
  USER_STEPS,
  CTA,
  COMPARISON,
} from '@data/home';
import procurement from '@data/projects.json';
import { t, pick, type Locale } from '@i18n/utils';
import { formatNumber, shortAddress } from '@utils/format';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const l = (path: string) => getRelativeLocaleUrl(lang, path);
const snapshotSupply = procurement.projects.reduce(
  (sum, p) => sum + Number(p.supplySnapshot || 0),
  0
);
const snapshotCount = procurement.projects.length;
const provinceMap = new Map<string, number>();
for (const project of procurement.projects) {
  provinceMap.set(project.province, (provinceMap.get(project.province) || 0) + 1);
}
const provinceCounts = [...provinceMap.entries()].sort((a, b) => b[1] - a[1]);
const maxProvince = Math.max(...provinceCounts.map(([, count]) => count), 1);

const docs = [
  {
    icon: 'FileText',
    title: lang === 'th' ? 'ไวท์เปเปอร์ v1.0' : 'Whitepaper v1.0',
    body:
      lang === 'th'
        ? 'เอกสารต้นฉบับ 48 หน้า ครอบคลุมโทเคโนมิกส์ การกำกับดูแล ความเสี่ยง และกระบวนการแลกคืน'
        : 'The 48-page source document covering tokenomics, governance, risk and redemption.',
    href: l('whitepaper'),
    meta: lang === 'th' ? '48 หน้า · PDF' : '48 pages · PDF',
  },
  {
    icon: 'FileBarChart',
    title: lang === 'th' ? 'รายงานพอร์ต' : 'Portfolio reports',
    body:
      lang === 'th'
        ? 'ข้อมูลรายเดือนเกี่ยวกับจำนวนโทเคน องค์ประกอบสินทรัพย์ การไถ่ถอน และสถานะการกระทบยอด'
        : 'Monthly supply, asset composition, retirement and reconciliation status.',
    href: l('reports'),
    meta: lang === 'th' ? 'รายเดือน' : 'Monthly',
  },
  {
    icon: 'Megaphone',
    title: lang === 'th' ? 'ประกาศอย่างเป็นทางการ' : 'Official announcements',
    body:
      lang === 'th'
        ? 'แถลงการณ์เกี่ยวกับความรับผิดของผู้ออกโทเคนและนิยามของเหตุการณ์ไม่พึงประสงค์'
        : 'The issuer liability statement and the definition of an Adverse Incident.',
    href: l('announcement'),
    meta: lang === 'th' ? 'แถลงการณ์' : 'Statement',
  },
  {
    icon: 'Scale',
    title: lang === 'th' ? 'การกำกับดูแล' : 'Regulatory overview',
    body:
      lang === 'th'
        ? 'ข้อมูลผู้ออกโทเคน การจำแนกประเภท การควบคุม การดูแลทรัพย์สิน และสิทธิ์ตามกรอบการรายงาน'
        : 'Issuer, classification, controls, custody and framework eligibility.',
    href: l('compliance'),
    meta: lang === 'th' ? 'ศูนย์ข้อมูล' : 'Evidence hub',
  },
];
---

<BaseLayout
  title={lang === 'th' ? 'REC Token - ใบรับรองพลังงานหมุนเวียนบนบล็อกเชน' : 'REC Token - Verified renewable energy certificates, on-chain'}
  description={pick(HERO.lede, lang)}
  locale={lang}
  ogImage={`/og/home-${lang}.png`}
>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container-page hero-layout">
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span class="dot"></span>
          {pick(HERO.eyebrow, lang)}
        </p>
        <h1>
          {lang === 'th' ? (
            <>เมกะวัตต์ชั่วโมง<br />ที่ตรวจสอบแล้ว</>
          ) : (
            <>The verified<br /><span class="hero-nowrap">megawatt-hour,</span></>
          )}
          <br />
          <em>{lang === 'th' ? 'บนบล็อกเชน' : 'on-chain.'}</em>
        </h1>
        <p class="hero-lede">{pick(HERO.lede, lang)}</p>

        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={l('whitepaper')}>
            {lang === 'th' ? 'อ่านไวท์เปเปอร์' : 'Read the whitepaper'}
            <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
          </a>
          <a class="btn btn-secondary btn-lg" href={l('compliance')}>
            {lang === 'th' ? 'ศูนย์ข้อมูลกำกับดูแล' : 'Regulatory overview'}
          </a>
        </div>
        <a class="hero-inline-link" href={l('data')}>
          {lang === 'th' ? 'เปิดแดชบอร์ดเรียลไทม์' : 'Open the live dashboard'}
          <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
        </a>

        <ul class="hero-meta">
          {HERO.meta.map((item) => (
            <li class="hero-meta-item">
              <Check size={13} stroke-width={2.4} aria-hidden="true" />
              {pick(item, lang)}
            </li>
          ))}
        </ul>
      </div>

      <aside class="instrument" aria-label={lang === 'th' ? 'ข้อมูลการออกโทเคน' : 'Issuance monitor'} data-live-stats>
        <div class="instrument-head">
          <span class="instrument-title">
            <span class="dot dot-live"></span>
            {lang === 'th' ? (
              <span>ติดตามสถานะโทเคน<wbr /><span class="nowrap">แบบเรียลไทม์</span></span>
            ) : (
              'Issuance monitor'
            )}
          </span>
          <span class="instrument-live">
            <span class="dot"></span>
            {lang === 'th' ? 'สด' : 'Live'}<span class="live-chain"> · ThaiFi</span>
          </span>
        </div>

        <div class="instrument-body">
          <div class="instrument-equation">
            <strong>1 REC</strong>
            <span class="eq-mark" aria-hidden="true">=</span>
            <strong>1 MWh</strong>
            <span>
              {lang === 'th' ? 'ใช้ I-REC เป็นสินทรัพย์อ้างอิง' : 'I-REC as reference asset'}<br />
              {lang === 'th' ? 'ไถ่ถอนแบบ FIFO ตามวินเทจ' : 'FIFO redemption by vintage'}
            </span>
          </div>

          <div class="instrument-grid">
            <div class="instrument-cell">
              <span class="kpi-label">{lang === 'th' ? 'จำนวนพูลโทเคน' : 'Pool token supply'}</span>
              <div class="kpi-value">
                <span data-stat="pool" data-stat-format="compact">-</span>
                <span class="unit">REC</span>
              </div>
            </div>
            <div class="instrument-cell">
              <span class="kpi-label">{lang === 'th' ? 'ไถ่ถอนแล้ว' : 'Retired'}</span>
              <div class="kpi-value">
                <span data-stat="retired" data-stat-format="compact">-</span>
                <span class="unit">REC</span>
              </div>
            </div>
            <div class="instrument-cell">
              <span class="kpi-label">{lang === 'th' ? 'โทเคนรายโครงการ' : 'Project tokens'}</span>
              <div class="kpi-value">
                <span data-stat="project-supply" data-stat-format="compact">
                  {formatNumber(snapshotSupply, lang, { maximumFractionDigits: 0 })}
                </span>
                <span class="unit">REC</span>
              </div>
            </div>
            <div class="instrument-cell">
              <span class="kpi-label">{lang === 'th' ? 'โครงการ' : 'Projects'}</span>
              <div class="kpi-value">
                <span data-stat="project-count" data-stat-format="int">{snapshotCount}</span>
              </div>
            </div>
          </div>

          <div class="instrument-foot">
            <span data-stat="updated">chain 17 · rpc.thaifi.com</span>
            <a href={l('data')}>
              {lang === 'th' ? 'เปิดแดชบอร์ด' : 'Open dashboard'}
              <ArrowRight size={11} stroke-width={2.4} aria-hidden="true" />
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============================== TRUST STRIP ============================== -->
  <div class="trust-strip" aria-label={lang === 'th' ? 'มาตรฐานและพันธมิตร' : 'Standards and partners'}>
    <div class="marquee">
      <div class="marquee-track">
        {[
          ['I-REC', 'I-TRACK'],
          ['Evident', lang === 'th' ? 'ทะเบียนอย่างเป็นทางการ' : 'Official registry'],
          ['REDEX', 'ReHash'],
          ['Valix Consulting', lang === 'th' ? 'ตรวจสอบสัญญา' : 'Contract audit'],
          ['Baker & McKenzie', lang === 'th' ? 'ที่ปรึกษากฎหมาย' : 'Legal counsel'],
          ['ThaiFi', 'Chain 17'],
          [lang === 'th' ? 'กระทบยอดรายไตรมาส' : 'Quarterly reconciliation', '1:1'],
          ['NetZero Carbon', lang === 'th' ? 'ผู้รวบรวมสินทรัพย์' : 'Asset aggregator'],
        ].map(([name, note]) => (
          <span class="trust-item">
            <span class="dot"></span>
            <strong>{name}</strong>
            {note}
          </span>
        ))}
        {[
          ['I-REC', 'I-TRACK'],
          ['Evident', lang === 'th' ? 'ทะเบียนอย่างเป็นทางการ' : 'Official registry'],
          ['REDEX', 'ReHash'],
          ['Valix Consulting', lang === 'th' ? 'ตรวจสอบสัญญา' : 'Contract audit'],
          ['Baker & McKenzie', lang === 'th' ? 'ที่ปรึกษากฎหมาย' : 'Legal counsel'],
          ['ThaiFi', 'Chain 17'],
          [lang === 'th' ? 'กระทบยอดรายไตรมาส' : 'Quarterly reconciliation', '1:1'],
          ['NetZero Carbon', lang === 'th' ? 'ผู้รวบรวมสินทรัพย์' : 'Asset aggregator'],
        ].map(([name, note]) => (
          <span class="trust-item" aria-hidden="true">
            <span class="dot"></span>
            <strong>{name}</strong>
            {note}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================== ASSET ============================== -->
  <section class="section" id="asset">
    <div class="container-page">
      <SectionHead
        index={ASSET_SECTION.index}
        eyebrow={pick(ASSET_SECTION.eyebrow, lang)}
        title={pick(ASSET_SECTION.title, lang)}
        description={pick(ASSET_SECTION.lede, lang)}
      />
      <div class="asset-split">
        <div class="asset-visual reveal" aria-hidden="true">
          <div class="asset-visual-glow"></div>
          <div class="certificate">
            <div class="certificate-head">
              <span class="certificate-label">I-REC</span>
              <span class="certificate-seal"><Icon name="ShieldCheck" size={15} /></span>
            </div>
            <div class="certificate-title">Renewable Energy Certificate</div>
            <div class="certificate-rows">
              <div><span>Unit</span><strong>1 MWh</strong></div>
              <div><span>Standard</span><strong>I-TRACK</strong></div>
              <div><span>Registry</span><strong>Evident</strong></div>
              <div><span>Vintage</span><strong>2024</strong></div>
            </div>
            <div class="certificate-code">IREC-••••-VN-2024</div>
          </div>
          <div class="asset-connector">
            <span class="connector-line"></span>
            <span class="connector-label"><Icon name="Lock" size={12} /> Locked in ReHash</span>
            <span class="connector-line"></span>
          </div>
          <div class="asset-token">
            <span class="asset-token-dot"></span>
            <div>
              <strong>1 REC</strong>
              <small>Pool token · ThaiFi</small>
            </div>
          </div>
        </div>

        <div class="asset-layers">
          {ASSET_SECTION.cards.map((card, i) => (
            <article class="asset-layer reveal" style={`--i:${i}`}>
              <span class="asset-layer-no">0{i + 1}</span>
              <div>
                <div class="asset-layer-head">
                  <h3>{pick(card.title, lang)}</h3>
                  <span class="chip">{pick(card.tag, lang)}</span>
                </div>
                <p>{pick(card.body, lang)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="compare-panel">
        <div class="compare-copy">
          <span class="chip">
            <Icon name="Scale" size={12} />
            {lang === 'th' ? 'การเปรียบเทียบ' : 'Comparison'}
          </span>
          <h3 class="h3 balance" style="margin-top:14px">{pick(COMPARISON.title, lang)}</h3>
          <p class="compare-note">
            {lang === 'th'
              ? 'REC แสดงถึงการผลิตไฟฟ้าจากพลังงานหมุนเวียน 1 MWh ส่วนคาร์บอนเครดิตแสดงถึงการลดหรือกักเก็บก๊าซเรือนกระจก 1 tCO₂e โดยเครดิต T-VER เป็นเครดิตที่ได้รับการรับรองจาก อบก. ของไทย'
              : 'A REC evidences 1 MWh of renewable electricity. A carbon credit evidences 1 tCO₂e reduced or removed. A T-VER credit is a Thai TGO-certified reduction or removal.'}
          </p>
          <a class="link-arrow" href={l('compliance/claims')} style="margin-top:18px">
            {lang === 'th' ? 'อ่านขอบเขตการกล่าวอ้าง' : 'Read the claim boundaries'}
            <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
          </a>
        </div>
        <div class="compare-table">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>REC Token</th>
                <th>{lang === 'th' ? 'คาร์บอนเครดิต / T-VER' : 'Carbon credit / T-VER'}</th>
              </tr>
            </thead>
            <tbody>
              {COMPARISON.rows.map((row) => (
                <tr>
                  <td>{pick(row.label, lang)}</td>
                  <td><strong>{pick(row.rec, lang)}</strong></td>
                  <td>{pick(row.carbon, lang)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== REGULATORS ============================== -->
  <section class="section section-rule" id="regulators">
    <div class="container-page">
      <SectionHead
        index={REGULATOR_SECTION.index}
        eyebrow={pick(REGULATOR_SECTION.eyebrow, lang)}
        title={pick(REGULATOR_SECTION.title, lang)}
        description={pick(REGULATOR_SECTION.lede, lang)}
      />

      <div data-tabs>
        <div class="reg-tabs" role="tablist" aria-label={lang === 'th' ? 'หน่วยงานกำกับดูแล' : 'Regulators'}>
          {REGULATOR_PROFILES.map((profile, i) => (
            <button
              type="button"
              class="reg-tab"
              role="tab"
              id={`tab-${profile.id}`}
              data-tab={profile.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${profile.id}`}
            >
              <span class="dot" aria-hidden="true"></span>
              {pick(profile.label, lang)}
            </button>
          ))}
        </div>

        {REGULATOR_PROFILES.map((profile, i) => (
          <div
            class="reg-panel"
            role="tabpanel"
            id={`panel-${profile.id}`}
            data-tab-panel={profile.id}
            aria-labelledby={`tab-${profile.id}`}
            hidden={i !== 0}
          >
            <div class="reg-layout">
              <div>
                <p class="reg-short">{pick(profile.short, lang)}</p>
                <h3 class="h3 balance" style="margin-top:10px">{pick(profile.headline, lang)}</h3>
                <p class="lede" style="margin-top:14px;font-size:1rem">{pick(profile.body, lang)}</p>
                <a class="link-arrow" href={l('compliance')} style="margin-top:22px">
                  {lang === 'th' ? 'ดูหลักฐานการกำกับดูแล' : 'Open the regulatory evidence'}
                  <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
                </a>

                <div class="evidence-chain" aria-hidden="true">
                  <span class="evidence-node">
                    <Icon name="FileCheck2" size={15} />
                    {lang === 'th' ? 'การเปิดเผยของผู้ออก' : 'Issuer disclosure'}
                  </span>
                  <span class="evidence-link"></span>
                  <span class="evidence-node">
                    <Icon name="ShieldCheck" size={15} />
                    {lang === 'th' ? 'การตรวจสอบอิสระ' : 'Independent audit'}
                  </span>
                  <span class="evidence-link"></span>
                  <span class="evidence-node">
                    <Icon name="Database" size={15} />
                    {lang === 'th' ? 'บันทึกบนเชน' : 'On-chain record'}
                  </span>
                </div>
              </div>
              <dl class="evidence-list">
                {profile.facts.map((fact) => (
                  <div class="evidence-row">
                    <dt>{pick(fact.k, lang)}</dt>
                    <dd>
                      {pick(fact.v, lang)}
                      <small>{pick(fact.note, lang)}</small>
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== LIFECYCLE ============================== -->
  <section class="section section-rule" id="lifecycle">
    <div class="container-page">
      <SectionHead
        index={LIFECYCLE.index}
        eyebrow={pick(LIFECYCLE.eyebrow, lang)}
        title={pick(LIFECYCLE.title, lang)}
        description={pick(LIFECYCLE.lede, lang)}
      />
      <div class="lifecycle">
        {LIFECYCLE.steps.map((step, i) => (
          <article class="lifecycle-step reveal" style={`--i:${i}`}>
            <div class="lifecycle-top">
              <span class="lifecycle-num">{step.no}</span>
              <span class="lifecycle-icon">
                <Icon
                  name={
                    ['FileCheck2', 'Lock', 'Coins', 'Network', 'ArrowLeftRight', 'Recycle'][i] ||
                    'CircleHelp'
                  }
                  size={17}
                />
              </span>
            </div>
            <h4>{pick(step.title, lang)}</h4>
            <p>{pick(step.body, lang)}</p>
            <div class="lifecycle-tags">
              {pick(step.who, lang).split(' / ').map((operator) => (
                <span class="chip">{operator}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== LIVE DATA ============================== -->
  <section class="section section-rule" id="transparency" data-live-stats>
    <div class="container-page">
      <SectionHead
        index="04"
        eyebrow={lang === 'th' ? 'ความโปร่งใสแบบเรียลไทม์' : 'Live transparency'}
        title={lang === 'th' ? 'ข้อมูลเรียลไทม์ที่อ่านโดยตรงจาก ThaiFi' : 'Live data read directly from ThaiFi.'}
        description={
          lang === 'th'
            ? 'จำนวนโทเคน การไถ่ถอน และการกระจายข้ามเชน ตรวจสอบโดยตรงจาก ThaiFi และบล็อกเชนสาธารณะ ทุกข้อมูลมีที่อยู่สัญญาและ explorer ให้ตรวจสอบได้'
            : 'Pool supply, retirements and bridged balances, read directly from ThaiFi and public chains.'
        }
      >
        <a class="link-arrow" href={l('data')}>
          {lang === 'th' ? 'ดูแดชบอร์ดฉบับเต็ม' : 'Open the full dashboard'}
          <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
        </a>
      </SectionHead>

      <div class="dash-strip">
        <div class="dash-cell">
          <span class="kpi-label">{lang === 'th' ? 'จำนวนพูลโทเคน' : 'Pool token supply'}</span>
          <div class="kpi-value">
            <span data-stat="pool" data-stat-format="full">-</span>
            <span style="font-size: 14px;color:var(--ink-3);font-family:var(--font-data)">REC</span>
          </div>
          <span class="delta">{lang === 'th' ? 'ThaiFi · chain 17' : 'ThaiFi · chain 17'}</span>
        </div>
        <div class="dash-cell">
          <span class="kpi-label">{lang === 'th' ? 'ไถ่ถอนแล้วทั้งหมด' : 'Total retired'}</span>
          <div class="kpi-value">
            <span data-stat="retired" data-stat-format="full">-</span>
            <span style="font-size: 14px;color:var(--ink-3);font-family:var(--font-data)">REC</span>
          </div>
          <span class="delta">{lang === 'th' ? 'เผาถาวร · ย้อนกลับไม่ได้' : 'Burned · irreversible'}</span>
        </div>
        <div class="dash-cell">
          <span class="kpi-label">{lang === 'th' ? 'โทเคนรายโครงการ' : 'Project tokens'}</span>
          <div class="kpi-value">
            <span data-stat="project-supply" data-stat-format="compact">-</span>
          </div>
          <span class="delta">
            <span data-stat="project-count" data-stat-format="int">{snapshotCount}</span>
            {lang === 'th' ? ' โครงการ' : ' projects'}
          </span>
        </div>
        <div class="dash-cell">
          <span class="kpi-label">{lang === 'th' ? 'จำนวนโทเคนที่โอนข้ามเชน' : 'Bridged out'}</span>
          <div class="kpi-value">
            <span data-stat="bridged-total" data-stat-format="compact">-</span>
          </div>
          <span class="delta">Optimism + Kubchain</span>
        </div>
      </div>

      <div class="registry-block">
        <div class="registry-head">
          <h3 class="h3">{lang === 'th' ? 'ทะเบียนสัญญาที่ใช้งาน' : 'Active contract registry'}</h3>
          <span class="chip"><span class="dot"></span>{lang === 'th' ? 'ตรวจสอบบนเชน' : 'Verified on-chain'}</span>

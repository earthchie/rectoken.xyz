<style>
  .lifecycle { position: relative; }
  .lifecycle::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 18%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brand), transparent);
    animation: lifecycle-scan 7s linear infinite;
    pointer-events: none;
    z-index: 2;
  }
  @keyframes lifecycle-scan {
    0% { transform: translateX(-110%); }
    100% { transform: translateX(660%); }
  }
  .lifecycle-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 16px;
  }
  .lifecycle-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--brand);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .lifecycle-step:hover .lifecycle-icon {
    background: var(--brand-soft);
    border-color: color-mix(in srgb, var(--brand) 35%, transparent);
  }
  .lifecycle-num { margin-bottom: 0; }

  .project-chart {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    margin-bottom: 22px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background:
      radial-gradient(360px circle at 6% 0%, var(--brand-soft), transparent 62%),
      linear-gradient(110deg, var(--surface), var(--surface-2));
  }
  .project-chart-head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .project-chart-head > div { display: flex; flex-direction: column; gap: 6px; }
  .project-chart-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .province-bars { display: grid; gap: 9px; }
  .province-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 30px;
    gap: 10px;
    align-items: center;
  }
  .province-name {
    font-size: 1rem;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .province-track {
    height: 9px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow: hidden;
  }
  .province-fill {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand), var(--accent));

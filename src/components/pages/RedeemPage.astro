---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowRight, Copy, ExternalLink, Info, ShieldCheck, Clock, Mail, Scale } from '@lucide/astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Icon from '@components/Icon.astro';
import { REDEMPTION_VAULTS, CHAINS, SITE } from '@data/site';
import { t, type Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const l = (path: string) => getRelativeLocaleUrl(lang, path);

const options = [
  {
    no: '01',
    title: lang === 'th' ? 'รับ I-REC บน REHASH' : 'Receive I-REC on REHASH',
    who: lang === 'th' ? 'นิติบุคคล' : 'Legal entities',
    body:
      lang === 'th'
        ? 'ให้บัญชี REHASH ที่ต้องการรับ I-REC จากนั้นคุณสามารถไถ่ถอนใบรับรองด้วยตนเองได้'
        : 'Provide the REHASH account that should receive the I-RECs. You can retire the certificates yourself afterwards.',
  },
  {
    no: '02',
    title: lang === 'th' ? 'ไถ่ถอนในนามบุคคลธรรมดา' : 'Retire on behalf of an individual',
    who: lang === 'th' ? 'บุคคลธรรมดา' : 'Individuals',
    body:
      lang === 'th'
        ? 'ให้ชื่อผู้รับประโยชน์และเหตุผลในการไถ่ถอน BlockEdge จะไถ่ถอน I-REC ภายใต้บัญชีของบริษัทโดยบันทึกชื่อผู้รับประโยชน์ไว้'
        : 'Provide the beneficial name and reason for retirement. BlockEdge retires the I-RECs under its account with the beneficiary recorded.',
  },
];

const steps = [
  {
    no: '01',
    title: lang === 'th' ? 'โอนโทเคนไปยังห้องนิรภัย' : 'Transfer tokens to the vault',
    body: lang === 'th' ? 'ส่ง REC Token อย่างน้อย 100 REC ไปยังห้องนิรภัย (vault) ของ BlockEdge บน Optimism หรือ Kubchain' : 'Send at least 100 REC to the BlockEdge vault on Optimism or Kubchain.',
  },
  {
    no: '02',
    title: lang === 'th' ? 'ส่งคำขอ' : 'Submit the request',
    body:
      lang === 'th'
        ? 'กรอกข้อมูลติดต่อ บัญชี REHASH หรือข้อมูลผู้รับประโยชน์ แฮชธุรกรรม และตัวเลือกการแลกคืน'
        : 'Provide your contact details, REHASH account or beneficiary details, transaction hash and redemption option.',
  },
  {
    no: '03',
    title: lang === 'th' ? 'การทวนสอบ' : 'Verification',
    body: lang === 'th' ? 'ทีมงานตรวจสอบธุรกรรมและสิทธิ์ภายใน 3-14 วันทำการ' : 'The team verifies the transaction and eligibility within 3-14 business days.',
  },
  {
    no: '04',
    title: lang === 'th' ? 'ยืนยันก่อนเผา' : 'Pre-burn confirmation',
    body: lang === 'th' ? 'คุณเห็นรายละเอียดสินทรัพย์ที่จะจัดสรรก่อนเผา และยกเลิกได้โดยไม่มีค่าปรับ' : 'You see the assets to be allocated before the burn and may cancel without penalty.',
  },
];
---

<BaseLayout
  title={lang === 'th' ? 'แลกคืนหรือไถ่ถอน REC' : 'Redeem or retire REC'}
  description={lang === 'th' ? 'แปลง REC Token กลับเป็น I-REC หรือไถ่ถอนเพื่อกล่าวอ้างประโยชน์ด้านสิ่งแวดล้อมที่ตรวจสอบได้' : 'Convert REC Tokens back into I-RECs, or retire them for a verified environmental claim.'}
  locale={lang}
>
  <PageHero
    eyebrow={lang === 'th' ? 'เข้าร่วม' : 'Participate'}
    title={lang === 'th' ? 'แลกคืนหรือไถ่ถอน REC' : 'Redeem or retire REC'}
    description={lang === 'th' ? 'แปลงโทเคนกลับเป็นใบรับรองหรือไถ่ถอนเพื่อนำไปชดเชย ขั้นต่ำ 100 REC ต่อคำขอ และมีการยืนยันก่อนเผาทุกครั้ง' : 'Convert tokens back into certificates or retire them for a claim. Minimum 100 REC per request, with pre-burn confirmation every time.'}
    locale={lang}
    chips={[lang === 'th' ? 'ขั้นต่ำ 100 REC' : 'Minimum 100 REC', 'Optimism', 'Kubchain', lang === 'th' ? 'ย้อนกลับไม่ได้' : 'Irreversible']}
    actions={[
      { label: lang === 'th' ? 'การอุทธรณ์' : 'Appeals process', href: l('compliance/appeals'), variant: 'secondary' },
      { label: lang === 'th' ? 'คำถามที่พบบ่อย' : 'FAQ', href: l('faq') },
    ] as any}
  />

  <section class="section-tight">
    <div class="container-page">
      <div class="callout callout-info">
        <Info size={18} />
        <p>
          <strong>{lang === 'th' ? 'ขั้นต่ำ 100 REC ต่อคำขอ' : 'Minimum 100 REC per request.'}</strong>{' '}
          {lang === 'th'
            ? 'ผู้ถือที่มียอดต่ำกว่านี้ไม่สามารถส่งคำขอแลกคืนหรือไถ่ถอนโดยตรงได้ การโอนโทเคนไปยังห้องนิรภัย (vault) จะไม่เผาโทเคนจนกว่าจะผ่านการทวนสอบและการยืนยัน'
            : 'Holders below this threshold cannot submit a redemption or retirement request directly. Transferring to the vault does not burn tokens until verification and confirmation are complete.'}
        </p>
      </div>

      <div class="redeem-options">
        {options.map((option) => (
          <article class="redeem-option">
            <div class="redeem-option-head">
              <span class="step-no">{option.no}</span>
              <span class="chip">{option.who}</span>
            </div>
            <h3>{option.title}</h3>
            <p>{option.body}</p>
          </article>
        ))}
      </div>

      <div class="redeem-layout">
        <div class="redeem-guide">
          <div class="redeem-card">
            <h2 class="h3">{lang === 'th' ? 'วิธีแลกคืน' : 'How to redeem'}</h2>
            <div class="timeline" style="margin-top:18px">
              {steps.map((step) => (
                <div class="timeline-item">
                  <h4>{step.title}</h4>
                  <p>{step.body}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="redeem-card">
            <h2 class="h3">{lang === 'th' ? 'ที่อยู่ห้องนิรภัยของ BlockEdge' : 'BlockEdge vault addresses'}</h2>
            <div class="vault">
              <div class="vault-head">
                <span class="chip chip-brand">Optimism</span>
                <a class="vault-link" href={`${CHAINS.optimism.explorer}/address/${REDEMPTION_VAULTS.optimism}`} target="_blank" rel="noopener noreferrer">
                  {lang === 'th' ? 'ดูบนเครื่องมือสำรวจบล็อกเชน' : 'View on explorer'} <ExternalLink size={11} />
                </a>
              </div>
              <div class="vault-address">
                <code>{REDEMPTION_VAULTS.optimism}</code>
                <button type="button" class="copy-btn" data-copy={REDEMPTION_VAULTS.optimism} aria-label={lang === 'th' ? 'คัดลอกที่อยู่ห้องนิรภัยบน Optimism' : 'Copy Optimism vault'}><Copy size={14} /></button>
              </div>
            </div>
            <div class="vault" style="margin-top:10px">
              <div class="vault-head">
                <span class="chip chip-brand">Kubchain</span>
                <a class="vault-link" href={`${CHAINS.kubchain.explorer}/address/${REDEMPTION_VAULTS.kubchain}`} target="_blank" rel="noopener noreferrer">
                  {lang === 'th' ? 'ดูบนเครื่องมือสำรวจบล็อกเชน' : 'View on explorer'} <ExternalLink size={11} />
                </a>
              </div>
              <div class="vault-address">
                <code>{REDEMPTION_VAULTS.kubchain}</code>
                <button type="button" class="copy-btn" data-copy={REDEMPTION_VAULTS.kubchain} aria-label={lang === 'th' ? 'คัดลอกที่อยู่ห้องนิรภัยบน Kubchain' : 'Copy Kubchain vault'}><Copy size={14} /></button>
              </div>
            </div>
            <p class="vault-note">
              <Icon name="TriangleAlert" size={13} />
              {lang === 'th' ? 'ส่งเฉพาะบนเครือข่ายที่ระบุ การส่งผิดเครือข่ายอาจทำให้สูญเสียอย่างถาวร' : 'Send only on the network shown. Sending on the wrong network can cause permanent loss.'}
            </p>
          </div>
        </div>

        <div class="redeem-form-card" data-redeem>
          <div data-redeem-form-wrap>
            <h2 class="h3">{lang === 'th' ? 'ส่งคำขอแลกคืน' : 'Submit a redemption request'}</h2>
            <p class="redeem-form-sub">{lang === 'th' ? 'กรอกรายละเอียดการโอนโทเคน แล้วระบบจะสร้างอีเมลคำขอให้คุณส่งจากแอปอีเมลของคุณ' : 'Enter the details of your token transfer and we will prepare an email you send from your mail app.'}</p>

            <form class="redeem-form" data-redeem-form novalidate>
              <div class="form-grid">
                <div class="field">
                  <label class="field-label" for="redeem-name">{lang === 'th' ? 'ชื่อผู้ติดต่อ *' : 'Contact name *'}</label>
                  <input class="input" id="redeem-name" name="name" type="text" required autocomplete="name" placeholder={lang === 'th' ? 'ชื่อและนามสกุล' : 'Full name'} data-redeem-name />
                </div>
                <div class="field">
                  <label class="field-label" for="redeem-email">{lang === 'th' ? 'อีเมล *' : 'Email address *'}</label>
                  <input class="input" id="redeem-email" name="email" type="email" required autocomplete="email" placeholder="your.email@example.com" data-redeem-email />
                </div>
                <div class="field">
                  <label class="field-label" for="redeem-phone">{lang === 'th' ? 'เบอร์โทรศัพท์ *' : 'Phone number *'}</label>
                  <input class="input" id="redeem-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+66 8x xxx xxxx" data-redeem-phone />
                </div>
                <div class="field">
                  <label class="field-label" for="redeem-option">{lang === 'th' ? 'ตัวเลือกการแลกคืน *' : 'Redemption option *'}</label>
                  <select class="select" id="redeem-option" name="option" data-redeem-option>
                    <option value="rehash">{lang === 'th' ? 'รับ I-REC บน REHASH' : 'Receive I-REC on REHASH'}</option>
                    <option value="individual">{lang === 'th' ? 'ไถ่ถอนในนามบุคคลธรรมดา' : 'Retire on behalf of an individual'}</option>
                  </select>
                </div>

                <div class="field form-span" data-redeem-rehash-field>
                  <label class="field-label" for="redeem-rehash">{lang === 'th' ? 'บัญชี REHASH *' : 'REHASH account *'}</label>
                  <input class="input" id="redeem-rehash" name="rehashAccount" placeholder={lang === 'th' ? 'อีเมลหรือรหัสบัญชี REHASH' : 'REHASH account email or ID'} data-redeem-rehash />
                  <span class="field-hint">{lang === 'th' ? 'I-REC จะถูกโอนเข้าบัญชีนี้ คุณสามารถไถ่ถอนด้วยตนเองได้หลังจากนั้น' : 'The I-RECs will be transferred to this account; you can retire them yourself afterwards.'}</span>
                </div>

                <div class="form-span conditional-fields" data-redeem-individual-fields hidden>
                  <div class="field">
                    <label class="field-label" for="redeem-beneficial">{lang === 'th' ? 'ชื่อผู้รับประโยชน์ *' : 'Beneficial name *'}</label>
                    <input class="input" id="redeem-beneficial" name="beneficialName" placeholder={lang === 'th' ? 'ชื่อบุคคลที่จะบันทึกในการไถ่ถอน' : 'The individual’s name recorded in the retirement'} data-redeem-beneficial />
                    <span class="field-hint">{lang === 'th' ? 'ชื่อนี้จะถูกบันทึกในรายละเอียดการไถ่ถอน' : 'This name is recorded in the retirement details.'}</span>
                  </div>
                  <div class="field">
                    <label class="field-label" for="redeem-reason">{lang === 'th' ? 'เหตุผลในการไถ่ถอน *' : 'Reason for retirement *'}</label>
                    <textarea class="textarea" id="redeem-reason" name="retirementReason" rows={3} placeholder={lang === 'th' ? 'เช่น การรายงาน Scope 2 หรือข้อกำหนดด้าน ESG' : 'e.g. Scope 2 reporting or an ESG requirement'} data-redeem-reason></textarea>
                  </div>
                </div>

                <div class="field">
                  <label class="field-label" for="redeem-amount">{lang === 'th' ? 'จำนวนโทเคน (REC) *' : 'Amount (REC) *'}</label>
                  <input class="input" id="redeem-amount" name="amount" readonly inputmode="decimal" placeholder={lang === 'th' ? 'อ่านจากธุรกรรมอัตโนมัติ' : 'Read from the transaction'} data-redeem-amount />
                  <span class="field-hint">{lang === 'th' ? 'ระบบอ่านจำนวนจากแฮชธุรกรรมโดยอัตโนมัติ' : 'The amount is read automatically from the transaction hash.'}</span>
                </div>
                <div class="field">
                  <label class="field-label" for="redeem-network">{lang === 'th' ? 'เครือข่ายที่โอน *' : 'Network used *'}</label>
                  <select class="select" id="redeem-network" name="network" data-redeem-network>
                    <option value="optimism">Optimism</option>
                    <option value="kubchain">Kubchain</option>
                  </select>
                </div>

                <div class="field form-span">
                  <label class="field-label" for="redeem-hash">{lang === 'th' ? 'แฮชธุรกรรม *' : 'Transaction hash *'}</label>
                  <div class="input-row">
                    <input class="input mono" id="redeem-hash" name="transactionHash" required placeholder="0x…" spellcheck="false" data-redeem-hash />
                    <button type="button" class="btn btn-secondary btn-sm" data-redeem-check>{lang === 'th' ? 'ตรวจสอบ' : 'Check'}</button>
                  </div>
                  <span class="field-hint" data-redeem-tx-status aria-live="polite">
                    {lang === 'th' ? 'วางแฮชของการโอน REC Token ไปยังห้องนิรภัย ระบบจะอ่านจำนวนและผู้ส่งให้' : 'Paste the hash of your REC Token transfer to the vault. The amount and sender are read automatically.'}
                  </span>
                </div>

                <div class="field form-span">
                  <label class="field-label" for="redeem-notes">{lang === 'th' ? 'หมายเหตุ (ไม่บังคับ)' : 'Additional notes (optional)'}</label>
                  <textarea class="textarea" id="redeem-notes" name="notes" placeholder={lang === 'th' ? 'ข้อมูลเพิ่มเติมหรือคำขอพิเศษ…' : 'Any additional information or special instructions…'} data-redeem-notes></textarea>
                </div>
              </div>

              <p class="redeem-error" data-redeem-error hidden></p>

              <button type="submit" class="btn btn-primary redeem-submit" data-redeem-submit>
                {lang === 'th' ? 'เปิดอีเมลคำขอ' : 'Open request email'}
              </button>
            </form>
          </div>

          <div class="redeem-success" data-redeem-draft hidden>
            <div class="redeem-success-icon"><Mail size={26} stroke-width={1.8} /></div>
            <h2 class="h3">{lang === 'th' ? 'อีเมลคำขอพร้อมส่ง' : 'Request email ready'}</h2>
            <p>{lang === 'th' ? 'เราเปิดแอปอีเมลของคุณพร้อมรายละเอียดคำขอแล้ว กรุณากดส่งจากแอปอีเมล คำขอจะถือว่าได้รับเมื่อทีมงานตอบกลับ' : 'Your mail app should open with the request details. Send it from there. The request counts as received when our team replies.'}</p>
            <div class="redeem-success-actions">
              <a class="btn btn-primary" data-redeem-mailto href={`mailto:${SITE.supportEmail}`}>{lang === 'th' ? 'เปิดอีเมลอีกครั้ง' : 'Open the email again'}</a>
              <button type="button" class="btn btn-secondary" data-redeem-another>{lang === 'th' ? 'แก้ไขรายละเอียด' : 'Edit details'}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="redeem-info">
        <div class="redeem-info-card">
          <Clock size={18} />
          <h3>{lang === 'th' ? 'ระยะเวลาดำเนินการ' : 'Processing timeline'}</h3>
          <ul>
            <li>{lang === 'th' ? 'ทวนสอบคำขอ: 3-14 วันทำการ' : 'Request verification: 3-14 business days'}</li>
            <li>{lang === 'th' ? 'โอนไป REDEX: ภายใน 7 วันทำการหลังข้อมูลครบ' : 'Transfer to REDEX: within 7 business days after complete details'}</li>
            <li>{lang === 'th' ? 'ไถ่ถอนและออกหลักฐาน: 3-14 วันทำการ' : 'Retirement and evidence: 3-14 business days'}</li>
            <li>{lang === 'th' ? 'รวมทั้งหมด: ไม่เกิน 30 วันทำการ' : 'Total: no more than 30 business days'}</li>
          </ul>
        </div>
        <div class="redeem-info-card">
          <Mail size={18} />
          <h3>{lang === 'th' ? 'ฝ่ายช่วยเหลือ' : 'Support'}</h3>
          <ul>
            <li><a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></li>
            <li>{lang === 'th' ? 'ตอบกลับภายใน 24 ชั่วโมง' : 'Response within 24 hours'}</li>
            <li>{lang === 'th' ? 'จ.-ศ. 9:00-18:00 น. เวลาไทย' : 'Mon-Fri, 09:00-18:00 ICT'}</li>
          </ul>
        </div>
        <div class="redeem-info-card">
          <Scale size={18} />
          <h3>{lang === 'th' ? 'การอุทธรณ์' : 'Appeals'}</h3>
          <p>{lang === 'th' ? 'ปัญหาการใช้งานหลังยืนยันสามารถอุทธรณ์ได้ภายใน 14 วัน พร้อมแฮชธุรกรรมและเอกสารสนับสนุน' : 'Functional issue after confirmation? Appeal within 14 days with the transaction hash and supporting documents.'}</p>
          <a class="link-arrow" href={l('compliance/appeals')}>{lang === 'th' ? 'อ่านกระบวนการ' : 'Read the process'} <ArrowRight size={13} stroke-width={2} /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initRedeem } from '@scripts/redeem';
  initRedeem(document.documentElement.lang === 'th-TH' ? 'th' : 'en');
</script>

<style>
  .redeem-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
  @media (max-width: 860px) { .redeem-options { grid-template-columns: 1fr; } }
  .redeem-option { padding: 20px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .redeem-option-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  .redeem-option h3 { font-size: 1rem; line-height: 1.3; }
  .redeem-option p { margin-top: 6px; font-size: 1rem; line-height: 1.65; color: var(--ink-3); }

  .redeem-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 20px; margin-top: 22px; align-items: start; }
  @media (max-width: 980px) { .redeem-layout { grid-template-columns: 1fr; } }
  .redeem-guide { display: flex; flex-direction: column; gap: 14px; }
  .redeem-card { padding: 22px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .vault { padding: 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-2); margin-top: 14px; }
  .vault-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .vault-link { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 14px; color: var(--brand); }
  .vault-address { display: flex; align-items: center; gap: 6px; }
  .vault-address code { flex: 1; min-width: 0; font-family: var(--font-mono); font-size: 1rem; white-space: nowrap; overflow-x: auto; scrollbar-width: thin; color: var(--ink); }
  .vault-note { display: flex; gap: 6px; margin-top: 12px; font-size: 1rem; line-height: 1.55; color: var(--ink-3); }
  .vault-note svg { flex-shrink: 0; margin-top: 2px; color: var(--warning); }

  .redeem-form-card { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
  .redeem-form-sub { margin-top: 6px; font-size: 1rem; line-height: 1.6; color: var(--ink-3); }
  .redeem-form { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }
  .redeem-form .mono { font-family: var(--font-mono); font-size: 1rem; }
  .redeem-form .form-span { grid-column: 1 / -1; }
  .redeem-form [hidden] { display: none !important; }
  .redeem-form .conditional-fields { display: grid; gap: 16px; }

---
interface Props {
  index?: string;
  title: string;
  description?: string;
  eyebrow?: string;
}

const { index, title, description, eyebrow } = Astro.props;
---

<div class="section-head">
  <div>
    {(index || eyebrow) && (
      <p class="section-index">
        {index && <span>{index}</span>}
        {eyebrow}
      </p>
    )}
    <h2 class="h2 balance">{title}</h2>
  </div>
  <div class="section-aside">
    {description && <p class="lede">{description}</p>}
    <slot />
  </div>
</div>
